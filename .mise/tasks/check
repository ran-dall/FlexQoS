#!/usr/bin/env bash
#MISE description="Run all local development checks"

set -euo pipefail

cd "$MISE_PROJECT_ROOT"

checks=(
  check-pr-source
  shellcheck
  test-iptables
  actionlint
)

for check in "${checks[@]}"; do
  printf '\n==> %s\n' "$check"
  mise run "$check"
done

printf '\nAll checks passed.\n'
